---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="bestfinancecalculator.com | High-Performance Financial Tools"
  description="Localized, high-performance finance calculators. Get precise estimates for mortgages and personal loans tailored for the USA, UK, Canada, Australia, Ireland, and Singapore."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-20 lg:py-32 bg-page">
    <!-- Background blur graphics -->
    <div class="absolute top-0 left-1/4 -z-10 h-72 w-72 rounded-full bg-brand/10 blur-3xl"></div>
    <div class="absolute top-1/3 right-1/4 -z-10 h-96 w-96 rounded-full bg-brand/10 blur-3xl"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand ring-1 ring-inset ring-brand/20">
        ✨ 100% Free & Privacy First
      </span>
      <h1 class="mt-6 text-4xl sm:text-6xl font-extrabold font-display tracking-tight text-main-text max-w-3xl mx-auto leading-tight">
        Financial tools designed for <span class="text-brand">accuracy and speed</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-muted-text max-w-2xl mx-auto leading-relaxed">
        Get rapid, precise, and localized mortgage and loan projections. Tailored specifically for the tax, insurance, and payment structures of the USA, UK, Canada, Australia, Ireland, and Singapore.
      </p>
    </div>
  </section>

  <!-- Featured Tools Grid -->
  <section class="py-12 sm:py-16 bg-page">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold font-display tracking-tight text-main-text text-center">
        Explore our micro-calculators
      </h2>
      <p class="mt-2 text-muted-text text-center max-w-md mx-auto">
        Choose a localized tool below to start planning your finances.
      </p>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <!-- Mortgage Calculator Card -->
        <div class="group relative rounded-md border border-border bg-surface p-8 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="inline-flex rounded-md bg-brand/10 p-3 text-brand group-hover:scale-110 transition-transform duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v14.25A2.25 2.25 0 004.5 19.5h15a2.25 2.25 0 002.25-2.25V3m-18 0A2.25 2.25 0 014.5 1.5h15A2.25 2.25 0 0121.75 3m-18 9.75h18c-.03 0-.03-.007 0 0z" />
              </svg>
            </div>
            <h3 class="mt-6 text-xl font-bold font-display text-main-text">
              Mortgage Calculator
            </h3>
            <p class="mt-3 text-sm text-muted-text leading-relaxed">
              Plan your home purchase with accuracy. Includes advanced options for property tax, home insurance, and HOA fees. Optimized for home buyers in the <strong class="text-main-text">USA, UK, and Canada</strong>.
            </p>
            <ul class="mt-4 space-y-2 text-xs text-muted-text">
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Property taxes & insurance toggles
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Down payment ratio adjustment
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Amortization schedule previews
              </li>
            </ul>
          </div>
          <div class="mt-8">
            <a
              href="/mortgage-calculator"
              class="inline-flex w-full items-center justify-center rounded-md bg-brand hover:bg-brand-hover px-4 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors duration-200"
            >
              Calculate Mortgage
            </a>
          </div>
        </div>

        <!-- Personal Loan Calculator Card -->
        <div class="group relative rounded-md border border-border bg-surface p-8 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between hover:-translate-y-1">
          <div>
            <div class="inline-flex rounded-md bg-brand/10 p-3 text-brand group-hover:scale-110 transition-transform duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3 class="mt-6 text-xl font-bold font-display text-main-text">
              Personal Loan Calculator
            </h3>
            <p class="mt-3 text-sm text-muted-text leading-relaxed">
              Find out your true borrowing costs. Supports weekly, fortnightly, or monthly repayment frequency settings. Optimized for borrowers in <strong class="text-main-text">Australia and Singapore</strong>.
            </p>
            <ul class="mt-4 space-y-2 text-xs text-muted-text">
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Weekly/Fortnightly payment intervals
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Extra repayment impact simulations
              </li>
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand"></span> Total interest payout breakdown
              </li>
            </ul>
          </div>
          <div class="mt-8">
            <a
              href="/loan-calculator"
              class="inline-flex w-full items-center justify-center rounded-md bg-brand hover:bg-brand-hover px-4 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors duration-200"
            >
              Calculate Loan
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Value Props -->
  <section class="py-16 bg-surface border-t border-b border-border transition-colors duration-300">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Feature 1 -->
        <div class="text-center md:text-left">
          <h3 class="text-lg font-bold font-display text-main-text">Lightning Fast & Static</h3>
          <p class="mt-2 text-sm text-muted-text leading-relaxed">
            Built using Astro and static compilation. No heavy JS framework weight means instant page loads and seamless calculator interactions.
          </p>
        </div>
        <!-- Feature 2 -->
        <div class="text-center md:text-left">
          <h3 class="text-lg font-bold font-display text-main-text">Locally & Privacy Focused</h3>
          <p class="mt-2 text-sm text-muted-text leading-relaxed">
            All calculations are performed strictly inside your browser. No financial data is sent to servers, ensuring complete privacy.
          </p>
        </div>
        <!-- Feature 3 -->
        <div class="text-center md:text-left">
          <h3 class="text-lg font-bold font-display text-main-text">Localized Defaults</h3>
          <p class="mt-2 text-sm text-muted-text leading-relaxed">
            Defaults match real-world market norms of USA, UK, Canada, Australia, and Singapore, so you don't waste time entering basic regional info.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
