---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Personal Loan Calculator | bestfinancecalculator.com"
  description="Calculate your weekly, fortnightly, or monthly personal loan repayments with instant interest breakdowns and amortization visualization."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-12 text-center md:text-left">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand ring-1 ring-inset ring-brand/20">
        Australia & Singapore frequency options
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-main-text">
        Personal Loan Calculator
      </h1>
      <p class="mt-3 text-muted-text max-w-2xl">
        Calculate weekly, fortnightly, or monthly repayments on your personal loan. Find out how much total interest you will pay and estimate the impact of different repayment frequencies.
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Input Form Column -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Core Loan details -->
        <div class="rounded-md border border-border bg-surface p-6 sm:p-8 shadow-xs space-y-6">
          <h2 class="text-lg font-bold font-display text-main-text border-b border-border pb-4">
            1. Personal Loan Details
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Loan Amount -->
            <div class="space-y-2">
              <label for="input-loan-amount" class="block text-sm font-semibold text-main-text mb-1 flex items-center gap-1.5 relative group">
                Loan Amount
                <span tabindex="0" class="inline-flex items-center justify-center w-4 h-4 text-[10px] font-bold font-mono rounded-full bg-border text-muted-text cursor-help select-none focus:outline-hidden focus:ring-1 focus:ring-brand">i</span>
                <!-- Tooltip Box -->
                <span class="absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus-within:block w-56 p-2 text-xs font-normal leading-normal text-white bg-slate-900 dark:bg-slate-800 rounded-lg shadow-xl border border-border z-30 pointer-events-none">
                  The total amount of money you plan to borrow.
                </span>
              </label>
              <div class="relative rounded-md shadow-xs">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                  <span class="text-muted-text sm:text-sm font-medium">$</span>
                </div>
                <input
                  type="number"
                  id="input-loan-amount"
                  min="100"
                  step="500"
                  value="30000"
                  class="block w-full rounded-md border border-border bg-page text-main-text py-3 pl-8 pr-4 placeholder:text-muted-text focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:text-sm transition-all"
                />
              </div>
            </div>

            <!-- Interest Rate -->
            <div class="space-y-2">
              <label for="input-interest-rate" class="block text-sm font-semibold text-main-text mb-1 flex items-center gap-1.5 relative group">
                Interest Rate (p.a.)
                <span tabindex="0" class="inline-flex items-center justify-center w-4 h-4 text-[10px] font-bold font-mono rounded-full bg-border text-muted-text cursor-help select-none focus:outline-hidden focus:ring-1 focus:ring-brand">i</span>
                <!-- Tooltip Box -->
                <span class="absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus-within:block w-56 p-2 text-xs font-normal leading-normal text-white bg-slate-900 dark:bg-slate-800 rounded-lg shadow-xl border border-border z-30 pointer-events-none">
                  The annual interest rate (p.a.) offered by your lender.
                </span>
              </label>
              <div class="relative rounded-md shadow-xs">
                <input
                  type="number"
                  id="input-interest-rate"
                  min="0"
                  max="100"
                  step="0.01"
                  value="8.5"
                  class="block w-full rounded-md border border-border bg-page text-main-text py-3 pl-4 pr-8 placeholder:text-muted-text focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:text-sm transition-all"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <span class="text-muted-text sm:text-sm font-medium">%</span>
                </div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Loan Term -->
            <div class="space-y-2">
              <label for="input-loan-term" class="block text-sm font-semibold text-main-text mb-1 flex items-center gap-1.5 relative group">
                Loan Term
                <span tabindex="0" class="inline-flex items-center justify-center w-4 h-4 text-[10px] font-bold font-mono rounded-full bg-border text-muted-text cursor-help select-none focus:outline-hidden focus:ring-1 focus:ring-brand">i</span>
                <!-- Tooltip Box -->
                <span class="absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus-within:block w-56 p-2 text-xs font-normal leading-normal text-white bg-slate-900 dark:bg-slate-800 rounded-lg shadow-xl border border-border z-30 pointer-events-none">
                  How many years you have to pay back the loan.
                </span>
              </label>
              <div class="relative rounded-md shadow-xs">
                <input
                  type="number"
                  id="input-loan-term"
                  min="1"
                  max="100"
                  step="1"
                  value="5"
                  class="block w-full rounded-md border border-border bg-page text-main-text py-3 pl-4 pr-16 placeholder:text-muted-text focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:text-sm transition-all"
                />
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4">
                  <span class="text-muted-text sm:text-sm font-medium">Years</span>
                </div>
              </div>
            </div>

            <!-- Repayment Frequency -->
            <div class="space-y-2">
              <label for="input-frequency" class="block text-sm font-semibold text-main-text mb-1 flex items-center gap-1.5 relative group">
                Repayment Frequency
                <span tabindex="0" class="inline-flex items-center justify-center w-4 h-4 text-[10px] font-bold font-mono rounded-full bg-border text-muted-text cursor-help select-none focus:outline-hidden focus:ring-1 focus:ring-brand">i</span>
                <!-- Tooltip Box -->
                <span class="absolute bottom-full left-0 mb-1.5 hidden group-hover:block group-focus-within:block w-56 p-2 text-xs font-normal leading-normal text-white bg-slate-900 dark:bg-slate-800 rounded-lg shadow-xl border border-border z-30 pointer-events-none">
                  How often you make payments. Fortnightly can save you significant interest!
                </span>
              </label>
              <select
                id="input-frequency"
                class="block w-full rounded-md border border-border bg-page text-main-text py-3 px-4 focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand sm:text-sm transition-all"
              >
                <option value="52" class="bg-page text-main-text">Weekly</option>
                <option value="26" class="bg-page text-main-text" selected>Fortnightly</option>
                <option value="12" class="bg-page text-main-text">Monthly</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Column -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-6">
        <div class="rounded-md border border-border bg-surface p-8 shadow-sm">
          <!-- Total Headline -->
          <div class="text-center">
            <h3 id="payment-label" class="text-sm font-semibold text-muted-text uppercase tracking-wider">
              Fortnightly Repayment
            </h3>
            <p id="result-payment" class="mt-4 text-4xl sm:text-5xl font-extrabold font-display text-brand">
              $0.00
            </p>
          </div>

          <!-- Stacked Bar Chart -->
          <div class="mt-8">
            <div class="h-4 w-full rounded-full bg-border overflow-hidden flex">
              <!-- Principal segment -->
              <div id="bar-principal" class="h-full bg-brand transition-all duration-300" style="width: 0%"></div>
              <!-- Interest segment -->
              <div id="bar-interest" class="h-full bg-rose-500 dark:bg-rose-400 transition-all duration-300" style="width: 0%"></div>
            </div>
          </div>

          <!-- Breakdown List -->
          <div class="mt-8 space-y-4">
            <!-- Principal row -->
            <div class="flex items-center justify-between py-2 border-b border-border">
              <div class="flex items-center gap-2.5">
                <span class="h-3 w-3 rounded-full bg-brand shrink-0"></span>
                <span class="text-sm font-medium text-muted-text">Total Principal</span>
              </div>
              <div class="text-right">
                <span id="result-principal" class="text-sm font-bold text-main-text">$0.00</span>
                <span id="pct-principal" class="block text-[10px] text-muted-text">0%</span>
              </div>
            </div>

            <!-- Total Interest row -->
            <div class="flex items-center justify-between py-2 border-b border-border">
              <div class="flex items-center gap-2.5">
                <span class="h-3 w-3 rounded-full bg-rose-500 dark:bg-rose-400 shrink-0"></span>
                <span class="text-sm font-medium text-muted-text">Total Interest Paid</span>
              </div>
              <div class="text-right">
                <span id="result-interest" class="text-sm font-bold text-main-text">$0.00</span>
                <span id="pct-interest" class="block text-[10px] text-muted-text">0%</span>
              </div>
            </div>

            <!-- Total Repaid row -->
            <div class="flex items-center justify-between py-2">
              <div class="flex items-center gap-2.5">
                <span class="h-3 w-3 rounded-full bg-slate-300 dark:bg-slate-600 shrink-0"></span>
                <span class="text-sm font-medium text-muted-text">Total Amount Repaid</span>
              </div>
              <div class="text-right">
                <span id="result-total-repaid" class="text-sm font-bold text-main-text">$0.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // DOM Elements - Inputs
  const loanAmountInput = document.getElementById('input-loan-amount') as HTMLInputElement;
  const interestRateInput = document.getElementById('input-interest-rate') as HTMLInputElement;
  const loanTermInput = document.getElementById('input-loan-term') as HTMLInputElement;
  const frequencySelect = document.getElementById('input-frequency') as HTMLSelectElement;

  // DOM Elements - Results & Chart
  const paymentLabel = document.getElementById('payment-label') as HTMLElement;
  const resultPayment = document.getElementById('result-payment') as HTMLElement;
  const resultPrincipal = document.getElementById('result-principal') as HTMLElement;
  const resultInterest = document.getElementById('result-interest') as HTMLElement;
  const resultTotalRepaid = document.getElementById('result-total-repaid') as HTMLElement;

  const pctPrincipal = document.getElementById('pct-principal') as HTMLElement;
  const pctInterest = document.getElementById('pct-interest') as HTMLElement;

  const barPrincipal = document.getElementById('bar-principal') as HTMLElement;
  const barInterest = document.getElementById('bar-interest') as HTMLElement;

  // Frequency to label map
  const frequencyLabels: Record<string, string> = {
    '52': 'Weekly Repayment',
    '26': 'Fortnightly Repayment',
    '12': 'Monthly Repayment'
  };

  // Formatting helper
  function formatCurrency(amount: number): string {
    return amount.toLocaleString('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 2
    });
  }

  // Master calculation function
  function calculateLoan() {
    const principal = parseFloat(loanAmountInput.value) || 0;
    const annualInterestRate = parseFloat(interestRateInput.value) || 0;
    const loanTermYears = parseFloat(loanTermInput.value) || 5;
    const n = parseInt(frequencySelect.value) || 26;

    // Set label headline based on frequency
    paymentLabel.textContent = frequencyLabels[n.toString()] || 'Fortnightly Repayment';

    // Calculations
    const r = (annualInterestRate / 100) / n;
    const totalPayments = loanTermYears * n;

    let payment = 0;
    if (principal > 0 && totalPayments > 0) {
      if (r === 0) {
        payment = principal / totalPayments;
      } else {
        payment = principal * (
          (r * Math.pow(1 + r, totalPayments)) /
          (Math.pow(1 + r, totalPayments) - 1)
        );
      }
    }

    const totalRepaid = payment * totalPayments;
    const totalInterest = Math.max(0, totalRepaid - principal);

    // Display basic results
    resultPayment.textContent = formatCurrency(payment);
    resultPrincipal.textContent = formatCurrency(principal);
    resultInterest.textContent = formatCurrency(totalInterest);
    resultTotalRepaid.textContent = formatCurrency(totalRepaid);

    // Calculate percentages for chart & lists
    let principalPct = 0;
    let interestPct = 0;

    if (totalRepaid > 0) {
      principalPct = (principal / totalRepaid) * 100;
      interestPct = (totalInterest / totalRepaid) * 100;
    }

    // Update Percentage Labels
    pctPrincipal.textContent = `${principalPct.toFixed(1)}%`;
    pctInterest.textContent = `${interestPct.toFixed(1)}%`;

    // Update Stacked Bar widths
    barPrincipal.style.width = `${principalPct}%`;
    barInterest.style.width = `${interestPct}%`;
  }

  // Event Listeners
  loanAmountInput?.addEventListener('input', calculateLoan);
  interestRateInput?.addEventListener('input', calculateLoan);
  loanTermInput?.addEventListener('input', calculateLoan);
  frequencySelect?.addEventListener('change', calculateLoan);

  // Initial Calculation on Page Load
  calculateLoan();
</script>
