---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout 
  title={`${post.data.title} | bestfinancecalculator.com`}
  description={post.data.description}
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Back to Blog Link -->
    <div class="mb-8">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to Blog
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-12">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand ring-1 ring-inset ring-brand/20 mb-4">
        Financial Guide
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-main-text leading-tight">
        {post.data.title}
      </h1>
      <div class="mt-6 flex items-center gap-4 text-sm text-muted-text border-b border-border pb-8">
        <span>Published: {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
    </header>

    <!-- Article Content -->
    <article class="prose max-w-none">
      <Content />
    </article>

    <!-- Call to Action Box -->
    <div class="mt-12 rounded-md border border-border bg-surface p-8 text-center space-y-6">
      <h3 class="text-xl font-bold font-display text-main-text">
        Ready to project your calculations?
      </h3>
      <p class="text-muted-text max-w-lg mx-auto text-sm">
        Use our interactive, client-side tools to calculate mortgage payments, interest rates, and loan amortization in real-time.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/mortgage-calculator" 
          class="inline-flex items-center justify-center rounded-md bg-brand hover:bg-brand-hover px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors duration-200"
        >
          Mortgage Calculator
        </a>
        <a 
          href="/loan-calculator" 
          class="inline-flex items-center justify-center rounded-md border border-border bg-page hover:bg-surface px-6 py-3 text-sm font-semibold text-main-text shadow-sm transition-colors duration-200"
        >
          Personal Loan Calculator
        </a>
      </div>
    </div>
  </div>
</Layout>
