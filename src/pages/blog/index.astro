---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Fetch all posts and sort by pubDate descending
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout 
  title="Financial Guides & Articles | bestfinancecalculator.com"
  description="Explore our latest guides on mortgage payments, amortization schedules, and strategies to pay off loans faster."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-12 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand ring-1 ring-inset ring-brand/20">
        Guides & Advice
      </span>
      <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-main-text">
        Financial Guides
      </h1>
      <p class="mt-3 text-muted-text max-w-2xl mx-auto">
        Learn how mortgages work, what makes up your monthly payment, and how to use amortization to your advantage.
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {sortedPosts.map((post) => (
        <div class="flex flex-col justify-between rounded-md border border-border bg-surface p-6 sm:p-8 shadow-xs hover:border-brand/40 transition-colors duration-200">
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center rounded-md bg-brand/10 px-2.5 py-0.5 text-xs font-semibold text-brand">
                {post.data.title.includes('Mortgage') || post.data.title.includes('House') || post.data.title.includes('PMI') ? 'Mortgage Guide' : 'Loan Education'}
              </span>
              <span class="text-xs text-muted-text">
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
            </div>
            <h2 class="text-xl font-bold font-display text-main-text leading-snug">
              {post.data.title}
            </h2>
            <p class="text-sm text-muted-text leading-relaxed">
              {post.data.description}
            </p>
          </div>
          <div class="mt-6">
            <a 
              href={`/blog/${post.id}`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-hover transition-colors"
            >
              Read article
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
