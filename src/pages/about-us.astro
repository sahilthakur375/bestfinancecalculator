---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="About Us | bestfinancecalculator.com"
  description="Learn about our mission to provide lightning-fast, high-performance, and privacy-focused financial calculators."
>
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-main-text text-center">
        About Us
      </h1>
      <div class="mt-8 prose dark:prose-invert max-w-none text-muted-text space-y-6">
        <p>
          Welcome to <strong>bestfinancecalculator.com</strong>, a suite of high-performance financial calculators built with modern web technologies. Our goal is to replace slow, heavy, and ad-laden financial websites with clean, fast, and utility-focused experiences.
        </p>
        <p>
          We build with static compilation using Astro and pure vanilla JavaScript logic to ensure that pages load instantly and work completely offline inside your browser. Your privacy is our priority—all calculations run entirely client-side, and none of your sensitive financial input is ever transmitted to a server.
        </p>
      </div>
    </div>
  </div>
</Layout>
